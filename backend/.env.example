# backend/.env.example
# Copy this file to .env and fill in your values.
# Never commit the real .env file to version control.

# ── MongoDB ──────────────────────────────────────────────────
# Your MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/airbnb-clone?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────
# A long, random secret string used to sign tokens (min 32 chars)
JWT_SECRET=replace_with_a_long_random_secret_string_here
JWT_EXPIRES_IN=7d

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────
# The URL of your deployed React frontend (for production CORS)
CLIENT_URL=https://your-frontend-app.herokuapp.com
